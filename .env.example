# Cited — environment variables
# Copy this to .env locally, or set each as a Secret in Replit
# (Tools → Secrets in the Replit sidebar).

# ----- Anthropic API (optional) -----
# Currently NOT required by the v1 heuristic scorer. Keep this for the
# future LLM-enhanced Tier 2 upgrade.
ANTHROPIC_API_KEY=

# ----- PayFast (for Tier 2 / Tier 3 checkout) -----
# Get these from your PayFast merchant dashboard:
#   Settings → Integration (for live)
#   PayFast Sandbox dashboard (for testing)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a

# Passphrase: Only set this if you've enabled "Recurring Billing" or set a
# Security Passphrase in your PayFast Settings → Security. For one-off
# payments without recurring billing, leave empty.
# IMPORTANT: empty passphrase MUST be empty, not whitespace — production teams
# have hit signature mismatches from accidental whitespace in this value.
PAYFAST_PASSPHRASE=

# Set to "true" to use sandbox URLs (sandbox.payfast.co.za); "false" for live.
PAYFAST_SANDBOX=true

# ----- Public base URL -----
# The URL PayFast redirects back to. Must be publicly reachable for the
# ITN webhook to work.
# - During development: your *.replit.app URL
# - Production: https://cited.co.za
PUBLIC_BASE_URL=https://cited.co.za
