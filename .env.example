# Cited — environment variables
# Copy this to .env locally, or set each as a Secret in Replit
# (Tools → Secrets in the Replit sidebar).

# ----- Anthropic API (for keyword extraction in the scorer) -----
ANTHROPIC_API_KEY=sk-ant-...

# ----- Buttondown (for emailing free-tier reports) -----
# Optional. If unset, the on-screen result still works; users just
# don't get an email copy.
BUTTONDOWN_API_KEY=

# ----- PayFast (for Tier 2 / Tier 3 checkout) -----
# Get these from your PayFast merchant dashboard.
# Use SANDBOX credentials and PAYFAST_SANDBOX=true until you've tested
# the full flow end-to-end.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# ----- Public base URL -----
# The URL PayFast redirects back to. In Replit's deployment this is
# your custom domain once linked, e.g. https://cited.co.za
# During development it can be your .replit.app subdomain.
PUBLIC_BASE_URL=https://cited.co.za
